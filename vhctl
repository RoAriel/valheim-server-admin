# --- Contraseña del mundo ----------------------------------------------------

# Cambia VALHEIM_PASSWORD en /etc/valheim-server.env (nunca en el script de arranque),
# manteniendo permisos 600/root:root, y ofrece reiniciar ya mismo para aplicar el cambio.
cmd_password() {
    require_root
    local new_pass="${1:-}"
    if [[ -z "$new_pass" ]]; then
        echo "Uso: vhctl password <nueva_contraseña>" >&2
        exit 1
    fi
    if (( ${#new_pass} < 5 )); then
        echo "La contraseña debe tener al menos 5 caracteres (mínimo que exige Valheim)." >&2
        exit 1
    fi
    if [[ ! -f "$PASSWORD_FILE" ]]; then
        echo "No se encontró $PASSWORD_FILE" >&2
        exit 1
    fi

    if grep -q '^VALHEIM_PASSWORD=' "$PASSWORD_FILE"; then
        sed -i "s|^VALHEIM_PASSWORD=.*|VALHEIM_PASSWORD=${new_pass}|" "$PASSWORD_FILE"
    else
        echo "VALHEIM_PASSWORD=${new_pass}" >> "$PASSWORD_FILE"
    fi
    chmod 600 "$PASSWORD_FILE"
    chown root:root "$PASSWORD_FILE"
    echo "Contraseña actualizada en ${PASSWORD_FILE}."

    read -rp "¿Reiniciar el servidor ahora para aplicar el cambio? [s/N] " resp
    case "$resp" in
        [sS]|[sS][iI])
            echo "Generando backup antes de reiniciar..."
            do_backup
            systemctl restart "$SERVICE_NAME"
            echo "Servidor reiniciado con la nueva contraseña."
            ;;
        *)
            echo "No se reinició. La contraseña nueva recién se aplica con 'sudo vhctl reset' o 'sudo vhctl off && sudo vhctl on'."
            ;;
    esac
}

# --- Versionado de configuración (git) ------------------------------------

# Repo local (sin remoto todavía) donde vive el historial de config, armado en el
# paso 22 de la guía. CONFIG_FILES mapea cada archivo real del sistema a su nombre
# dentro del repo — agregar una fuente nueva acá es lo único que hace falta cuando
# sumamos un script más a la administración del server.
CONFIG_BACKUP_DIR="/srv/valheim/config-backup"
declare -A CONFIG_FILES=(
    ["/usr/local/bin/vhctl"]="vhctl"
    ["/opt/valheim-server/start_valheim.sh"]="start_valheim.sh"
    ["/etc/systemd/system/valheim.service"]="valheim.service"
    ["/etc/sudoers.d/vhctl"]="sudoers-vhctl"
    ["/usr/local/bin/valheim-healthcheck.sh"]="valheim-healthcheck.sh"
    ["/usr/local/bin/valheim-players-query.py"]="valheim-players-query.py"
    ["/usr/local/bin/valheim-track-players.py"]="valheim-track-players.py"
)
# Nota: /etc/valheim-server.env (la contraseña real) queda afuera a propósito —
# no se versiona nunca. Ver valheim-server.env.example dentro del repo.

# Copia todos los archivos de CONFIG_FILES + la carpeta de modificadores + el
# crontab de root al repo, y commitea si hubo cambios. Reemplaza la secuencia
# manual de "cp + git add + git commit" que se repetía a mano en cada edición.
cmd_gitsync() {
    require_root
    if [[ ! -d "${CONFIG_BACKUP_DIR}/.git" ]]; then
        echo "No hay un repo git en ${CONFIG_BACKUP_DIR}. Corré 'git init' ahí primero (paso 22 de la guía)." >&2
        exit 1
    fi

    # .gitignore de seguridad: nunca de más antes de tener un remoto en GitHub.
    if [[ ! -f "${CONFIG_BACKUP_DIR}/.gitignore" ]]; then
        cat > "${CONFIG_BACKUP_DIR}/.gitignore" <<'EOF'
*.env
*secret*
*password*
*.key
*.pem
EOF
        echo "Se creó .gitignore de seguridad en ${CONFIG_BACKUP_DIR}."
    fi

    local copied=0
    for src in "${!CONFIG_FILES[@]}"; do
        if [[ -f "$src" ]]; then
            cp "$src" "${CONFIG_BACKUP_DIR}/${CONFIG_FILES[$src]}"
            copied=$((copied + 1))
        else
            echo "Aviso: no se encontró '$src', se omite." >&2
        fi
    done

    if [[ -d "$MODIFIERS_DIR" ]]; then
        rm -rf "${CONFIG_BACKUP_DIR}/modifiers"
        cp -r "$MODIFIERS_DIR" "${CONFIG_BACKUP_DIR}/modifiers"
    fi

    # Referencia informativa del cron actual (no se ejecuta desde acá, solo queda documentado).
    crontab -l > "${CONFIG_BACKUP_DIR}/crontab-root.txt" 2>/dev/null || true

    echo "Copiados ${copied} archivo(s) a ${CONFIG_BACKUP_DIR}."

    cd "$CONFIG_BACKUP_DIR"
    git add .

    if git diff --cached --quiet; then
        echo "Sin cambios: el repo ya estaba al día."
        return 0
    fi

    echo "Cambios detectados:"
    git diff --cached --stat

    local msg="${1:-Actualización automática ($(date '+%Y-%m-%d %H:%M:%S'))}"
    git commit -m "$msg" --quiet
    echo "Commit creado: ${msg}"

    # Push automático al remoto, si hay uno configurado (ver paso 22 de la guía).
    # No es un error fatal si todavía no hay remoto, o si el push falla por red:
    # el commit ya quedó guardado localmente de todos modos.
    if git remote get-url origin &>/dev/null; then
        if git push origin HEAD 2>/tmp/vhctl_push_error.log; then
            echo "Cambios subidos a GitHub (origin)."
        else
            echo "Aviso: el commit se guardó localmente, pero el push a GitHub falló. Detalle:" >&2
            cat /tmp/vhctl_push_error.log >&2
        fi
        rm -f /tmp/vhctl_push_error.log
    fi
}

# --- Dispatcher principal ------------------------------------------------------

case "${1:-}" in
    on) cmd_on ;;
    off) cmd_off ;;
    reset) cmd_reset ;;
    status) cmd_status ;;
    backup) do_backup ;;
    backups) cmd_backups_list ;;
    update) cmd_update ;;
    password) cmd_password "${2:-}" ;;
    monitor) cmd_monitor ;;
    players) cmd_players "${2:-}" ;;
    gitsync) cmd_gitsync "${2:-}" ;;
    help|--help|-h) cmd_help ;;
    worlds)
        case "${2:-}" in
            list) cmd_worlds_list ;;
            create) cmd_worlds_create "${3:-}" "${@:4}" ;;
            switch) cmd_worlds_switch "${3:-}" ;;
            delete) cmd_worlds_delete "${3:-}" "${4:-}" ;;
            modifiers) cmd_worlds_modifiers "${3:-}" "${@:4}" ;;
            *) echo "Uso: vhctl worlds {list|create <nombre> [clave=valor ...]|switch <nombre>|delete <nombre> --confirm|modifiers <nombre> [set clave=valor ...]}" >&2; exit 1 ;;
        esac
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
