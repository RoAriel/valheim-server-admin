#!/bin/bash
set -euo pipefail

SERVICE_NAME="valheim"
START_SCRIPT="/opt/valheim-server/start_valheim.sh"
WORLD_DIR="/srv/valheim/worlds/worlds_local"
BACKUP_DIR="/srv/valheim/worlds/vhctl_backups"
MODIFIERS_DIR="/srv/valheim/worlds/modifiers"
RETENTION=5

declare -A VALID_MODIFIERS=(
    [combat]="veryeasy easy normal hard veryhard"
    [deathpenalty]="casual veryeasy easy normal hard hardcore"
    [resources]="muchless less normal more muchmore most"
    [raids]="none muchless less normal more muchmore"
    [portals]="casual normal hard veryhard"
    [playerevents]="true false"
    [passivemobs]="true false"
    [nobuildcost]="true false"
)

require_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "Este comando necesita sudo/root." >&2
        exit 1
    fi
}

get_world_name() {
    grep -oP '^WORLD_NAME="\K[^"]+' "$START_SCRIPT"
}

set_world_name() {
    local new_name="$1"
    sed -i "s/^WORLD_NAME=\".*\"/WORLD_NAME=\"${new_name}\"/" "$START_SCRIPT"
}

world_exists() {
    local name="$1"
    [[ -d "${WORLD_DIR}/${name}" || -f "${WORLD_DIR}/${name}.db" ]]
}

do_backup() {
    require_root
    local world_name
    world_name=$(get_world_name)

    mkdir -p "$BACKUP_DIR"
    local ts
    ts=$(date +%Y%m%d%H%M%S)
    local archive="${BACKUP_DIR}/vhctl_${world_name}_${ts}.tar.gz"

    if [[ -d "${WORLD_DIR}/${world_name}" ]]; then
        # Formato nuevo (carpeta, Valheim 1.0+)
        tar -czf "$archive" -C "$WORLD_DIR" "${world_name}"
    elif [[ -f "${WORLD_DIR}/${world_name}.db" && -f "${WORLD_DIR}/${world_name}.fwl" ]]; then
        # Formato clásico (.db + .fwl)
        tar -czf "$archive" -C "$WORLD_DIR" "${world_name}.db" "${world_name}.fwl"
    else
        echo "Aviso: no se encontraron archivos de '$world_name' en $WORLD_DIR, se omite backup."
        return
    fi

    chown valheim:valheim "$archive"
    echo "Backup creado: $archive"

    # Rotación: conservar solo los últimos $RETENTION
    local count
    count=$(ls -1 "${BACKUP_DIR}"/vhctl_*.tar.gz 2>/dev/null | wc -l)
    if (( count > RETENTION )); then
        ls -1t "${BACKUP_DIR}"/vhctl_*.tar.gz | tail -n +$((RETENTION + 1)) | xargs -r rm -f
        echo "Rotación: se conservan los últimos $RETENTION backups."
    fi
}

cmd_on() {
    require_root
    systemctl start "$SERVICE_NAME"
    echo "Servidor iniciado."
}

cmd_off() {
    require_root
    echo "Generando backup antes de apagar..."
    do_backup
    systemctl stop "$SERVICE_NAME"
    echo "Servidor detenido."
}

cmd_reset() {
    require_root
    echo "Generando backup antes de reiniciar..."
    do_backup
    systemctl restart "$SERVICE_NAME"
    echo "Servidor reiniciado."
}

cmd_status() {
    systemctl status "$SERVICE_NAME" --no-pager -l \
        | sed -E 's/(-password )[^[:space:]]+/\1********/' \
        | head -n 10
    echo "---"
    echo "Mundo activo: $(get_world_name)"
}

cmd_worlds_list() {
    echo "Mundos disponibles en $WORLD_DIR:"
    {
        find "$WORLD_DIR" -mindepth 1 -maxdepth 1 -type d ! -iname "*_backup_auto-*" -printf "%f\n" 2>/dev/null
        find "$WORLD_DIR" -mindepth 1 -maxdepth 1 -name "*.db" ! -iname "*_backup_auto-*" -printf "%f\n" 2>/dev/null | sed 's/\.db$//'
    } | sort -u
    echo ""
    echo "Mundo activo actualmente: $(get_world_name)"
}

cmd_worlds_modifiers() {
    local name="$1"
    shift || true
    if [[ -z "$name" ]]; then
        echo "Uso: vhctl worlds modifiers <nombre> [set clave=valor ...]" >&2
        exit 1
    fi
    mkdir -p "$MODIFIERS_DIR"
    local file="${MODIFIERS_DIR}/${name}.conf"

    if [[ "${1:-}" == "set" ]]; then
        require_root
        shift
        if [[ $# -eq 0 ]]; then
            echo "Uso: vhctl worlds modifiers <nombre> set clave=valor [clave=valor ...]" >&2
            exit 1
        fi
        touch "$file"
        for pair in "$@"; do
            local key="${pair%%=*}"
            local value="${pair#*=}"
            if [[ -z "${VALID_MODIFIERS[$key]:-}" ]]; then
                echo "Modificador desconocido: '$key'. Válidos: ${!VALID_MODIFIERS[*]}" >&2
                exit 1
            fi
            if [[ ! " ${VALID_MODIFIERS[$key]} " == *" ${value} "* ]]; then
                echo "Valor inválido para '$key': '$value'. Válidos: ${VALID_MODIFIERS[$key]}" >&2
                exit 1
            fi
            if grep -q "^${key}=" "$file" 2>/dev/null; then
                sed -i "s|^${key}=.*|${key}=${value}|" "$file"
            else
                echo "${key}=${value}" >> "$file"
            fi
            echo "Modificador '${key}' = '${value}' guardado para '${name}'."
        done
        chown valheim:valheim "$file"

        if world_exists "$name"; then
            local active_world
            active_world=$(get_world_name)
            if [[ "$name" == "$active_world" ]]; then
                read -rp "¿Reiniciar el servidor ahora para aplicar los modificadores? [s/N] " resp
                case "$resp" in
                    [sS]|[sS][iI])
                        echo "Generando backup antes de reiniciar..."
                        do_backup
                        systemctl restart "$SERVICE_NAME"
                        echo "Servidor reiniciado con los modificadores aplicados."
                        ;;
                    *)
                        echo "No se reinició. Se van a aplicar la próxima vez que reinicies con 'vhctl reset'."
                        ;;
                esac
            else
                echo "Guardado. Se va a aplicar la próxima vez que '$name' esté activo y el servidor se reinicie."
            fi
        else
            echo "Se van a aplicar cuando generes '$name' por primera vez con 'vhctl on'."
        fi
    else
        if [[ ! -s "$file" ]]; then
            echo "No hay modificadores configurados para '$name' (usa los valores por defecto de Valheim)."
            return 0
        fi
        echo "Modificadores configurados para '$name':"
        cat "$file"
    fi
}

cmd_worlds_create() {
    require_root
    local name="$1"
    shift || true
    if [[ -z "$name" ]]; then
        echo "Uso: vhctl worlds create <nombre> [clave=valor ...]" >&2
        exit 1
    fi
    if world_exists "$name"; then
        echo "Ya existe un mundo con ese nombre." >&2
        exit 1
    fi
    set_world_name "$name"
    echo "Mundo '$name' configurado. Se generará al iniciar el servidor."
    if [[ $# -gt 0 ]]; then
        cmd_worlds_modifiers "$name" set "$@"
    fi
    echo "Ejecutá 'vhctl on' o 'vhctl reset' para crearlo."
}

cmd_worlds_switch() {
    require_root
    local name="$1"
    if [[ -z "$name" ]]; then
        echo "Uso: vhctl worlds switch <nombre>" >&2
        exit 1
    fi
    if ! world_exists "$name"; then
        echo "No existe un mundo llamado '$name' en $WORLD_DIR." >&2
        exit 1
    fi
    echo "Generando backup del mundo actual antes de cambiar..."
    do_backup
    set_world_name "$name"
    systemctl restart "$SERVICE_NAME"
    echo "Cambiado al mundo '$name' y servidor reiniciado."
}

cmd_worlds_delete() {
    require_root
    local name="$1"
    local confirm="${2:-}"
    if [[ -z "$name" ]]; then
        echo "Uso: vhctl worlds delete <nombre> --confirm" >&2
        exit 1
    fi
    if ! world_exists "$name"; then
        echo "No existe un mundo llamado '$name' en $WORLD_DIR." >&2
        exit 1
    fi
    local active_world
    active_world=$(get_world_name)
    if [[ "$name" == "$active_world" ]]; then
        echo "No se puede borrar '$name': es el mundo activo. Cambiá a otro mundo primero con 'vhctl worlds switch'." >&2
        exit 1
    fi
    if [[ "$confirm" != "--confirm" ]]; then
        echo "Esto va a borrar permanentemente el mundo '${name}' (y sus backups nativos _auto)."
        echo "Repetí el comando agregando --confirm al final para confirmar:"
        echo "  vhctl worlds delete ${name} --confirm"
        exit 1
    fi

    echo "Generando backup de seguridad antes de borrar..."
    mkdir -p "$BACKUP_DIR"
    local safety_archive="${BACKUP_DIR}/vhctl_${name}_pre-delete_$(date +%Y%m%d%H%M%S).tar.gz"

    if [[ -d "${WORLD_DIR}/${name}" ]]; then
        tar -czf "$safety_archive" -C "$WORLD_DIR" "${name}" 2>/dev/null || true
        rm -rf "${WORLD_DIR}/${name}"
    else
        tar -czf "$safety_archive" -C "$WORLD_DIR" "${name}.db" "${name}.fwl" 2>/dev/null || true
        rm -f "${WORLD_DIR}/${name}.db" "${WORLD_DIR}/${name}.fwl"
    fi
    rm -rf "${WORLD_DIR}/${name}_backup_auto-"* 2>/dev/null || true

    echo "Mundo '$name' borrado. Se guardó un backup de seguridad en $BACKUP_DIR por si te arrepentís."
}

STEAM_APPID=896660
INSTALL_DIR="/opt/valheim-server"
MANIFEST_FILE="${INSTALL_DIR}/steamapps/appmanifest_${STEAM_APPID}.acf"
PASSWORD_FILE="/etc/valheim-server.env"

get_local_buildid() {
    if [[ -f "$MANIFEST_FILE" ]]; then
        grep -oP '"buildid"\s*"\K[0-9]+' "$MANIFEST_FILE" 2>/dev/null | head -1 || true
    fi
    return 0
}

get_remote_buildid() {
    su - valheim -c "steamcmd +login anonymous +app_info_update 1 +app_info_print ${STEAM_APPID} +quit" 2>/dev/null \
        | awk '/"public"/{f=1} f && /"buildid"/{print; exit}' \
        | grep -oP '"buildid"\s*"\K[0-9]+' || true
    return 0
}

cmd_update() {
    require_root
    echo "Consultando la última versión disponible en Steam..."
    local local_id remote_id
    local_id=$(get_local_buildid)
    remote_id=$(get_remote_buildid)

    if [[ -z "$remote_id" ]]; then
        echo "No se pudo consultar la versión remota (revisá la conexión de red del VPS o que steamcmd esté funcionando)." >&2
        exit 1
    fi

    echo "Versión instalada:  ${local_id:-desconocida}"
    echo "Versión disponible: ${remote_id}"

    if [[ -n "$local_id" && "$local_id" == "$remote_id" ]]; then
        echo "Ya estás en la última versión. No hace falta actualizar."
        return 0
    fi

    read -rp "Hay una actualización disponible. ¿Aplicarla ahora? [s/N] " resp
    case "$resp" in
        [sS]|[sS][iI])
            echo "Generando backup antes de actualizar..."
            do_backup
            systemctl stop "$SERVICE_NAME"
            echo "Actualizando servidor, esto puede tardar unos minutos..."
            su - valheim -c "steamcmd +force_install_dir ${INSTALL_DIR} +login anonymous +app_update ${STEAM_APPID} validate +quit"
            systemctl start "$SERVICE_NAME"
            echo "Actualización completa y servidor reiniciado."
            ;;
        *)
            echo "Actualización cancelada, no se modificó nada."
            ;;
    esac
}

cmd_backups_list() {
    echo "Backups de vhctl en ${BACKUP_DIR} (se conservan los últimos ${RETENTION}):"
    if [[ ! -d "$BACKUP_DIR" ]] || [[ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]]; then
        echo "Todavía no hay backups generados."
        return 0
    fi
    for f in $(ls -1t "${BACKUP_DIR}"/*.tar.gz 2>/dev/null); do
        local size
        size=$(du -h "$f" | cut -f1)
        echo "$(basename "$f")  —  ${size}"
    done
    echo "---"
    echo "Espacio total ocupado: $(du -sh "$BACKUP_DIR" | cut -f1)"
}

MONITOR_LOG="/var/log/valheim-monitor.log"

cmd_monitor() {
    if [[ ! -f "$MONITOR_LOG" ]]; then
        echo "Todavía no hay registros de monitoreo (el healthcheck corre cada 5 min vía cron)."
        return 0
    fi
    echo "Últimos cambios de estado registrados:"
    tail -n 30 "$MONITOR_LOG"
}

PLAYERS_QUERY_SCRIPT="/usr/local/bin/valheim-players-query.py"
PLAYERS_STATE_FILE="/var/lib/valheim/players-lastseen.json"

cmd_players() {
    if [[ "${1:-}" == "last" ]]; then
        if [[ ! -f "$PLAYERS_STATE_FILE" ]]; then
            echo "Todavía no hay registros de último acceso (el tracker corre cada 5 min vía cron)."
            return 0
        fi
        python3 - "$PLAYERS_STATE_FILE" <<'PYEOF'
import json
import sys

with open(sys.argv[1]) as f:
    data = json.load(f)

for name, ts in sorted(data.items(), key=lambda x: x[1], reverse=True):
    print(f"{ts}  -  {name}")
PYEOF
    else
        if [[ ! -f "$PLAYERS_QUERY_SCRIPT" ]]; then
            echo "El script de consulta de jugadores no está instalado (${PLAYERS_QUERY_SCRIPT})." >&2
            exit 1
        fi
        echo "Mundo activo: $(get_world_name)"
        python3 "$PLAYERS_QUERY_SCRIPT"
    fi
}

cmd_help() {
    cat <<'EOF'
vhctl — administración del servidor Valheim

Uso: vhctl <comando> [argumentos]

Comandos generales:
  on                                 Enciende el servidor
  off                                Apaga el servidor (con backup automático)
  reset                              Reinicia el servidor (con backup automático)
  status                             Estado del servicio y mundo activo
  backup                             Backup manual del mundo activo
  backups                            Lista los backups guardados (nombre, tamaño y total)
  update                             Consulta y aplica actualizaciones del juego
  password <nueva_contraseña>        Cambia la contraseña del mundo
  monitor                            Muestra el historial de caídas/recuperaciones detectadas
  players                            Jugadores conectados ahora mismo
  players last                       Último acceso registrado de cada jugador
  help                                Muestra esta ayuda

Comandos de mundos:
  worlds list                        Lista los mundos disponibles
  worlds create <nombre> [k=v ...]   Crea un mundo nuevo (con modificadores opcionales)
  worlds switch <nombre>             Cambia el mundo activo (con backup previo)
  worlds delete <nombre> --confirm   Borra un mundo (no permite borrar el activo)
  worlds modifiers <nombre>          Muestra los modificadores configurados
  worlds modifiers <nombre> set k=v  Configura modificadores (aplican con un reinicio)
EOF
}

cmd_password() {
    require_root
    local new_pass="${1:-}"
    if [[ -z "$new_pass" ]]; then
        echo "Uso: vhctl password <nueva_contraseña>" >&2
        exit 1
    fi
    if (( ${#new_pass} < 5 )); then
        echo "La contraseña debe tener al menos 5 caracteres (mínimo que exige Valheim)." >&2
        exit 1
    fi
    if [[ ! -f "$PASSWORD_FILE" ]]; then
        echo "No se encontró $PASSWORD_FILE" >&2
        exit 1
    fi

    if grep -q '^VALHEIM_PASSWORD=' "$PASSWORD_FILE"; then
        sed -i "s|^VALHEIM_PASSWORD=.*|VALHEIM_PASSWORD=${new_pass}|" "$PASSWORD_FILE"
    else
        echo "VALHEIM_PASSWORD=${new_pass}" >> "$PASSWORD_FILE"
    fi
    chmod 600 "$PASSWORD_FILE"
    chown root:root "$PASSWORD_FILE"
    echo "Contraseña actualizada en ${PASSWORD_FILE}."

    read -rp "¿Reiniciar el servidor ahora para aplicar el cambio? [s/N] " resp
    case "$resp" in
        [sS]|[sS][iI])
            echo "Generando backup antes de reiniciar..."
            do_backup
            systemctl restart "$SERVICE_NAME"
            echo "Servidor reiniciado con la nueva contraseña."
            ;;
        *)
            echo "No se reinició. La contraseña nueva recién se aplica con 'sudo vhctl reset' o 'sudo vhctl off && sudo vhctl on'."
            ;;
    esac
}

case "${1:-}" in
    on) cmd_on ;;
    off) cmd_off ;;
    reset) cmd_reset ;;
    status) cmd_status ;;
    backup) do_backup ;;
    backups) cmd_backups_list ;;
    update) cmd_update ;;
    password) cmd_password "${2:-}" ;;
    monitor) cmd_monitor ;;
    players) cmd_players "${2:-}" ;;
    help|--help|-h) cmd_help ;;
    worlds)
        case "${2:-}" in
            list) cmd_worlds_list ;;
            create) cmd_worlds_create "${3:-}" "${@:4}" ;;
            switch) cmd_worlds_switch "${3:-}" ;;
            delete) cmd_worlds_delete "${3:-}" "${4:-}" ;;
            modifiers) cmd_worlds_modifiers "${3:-}" "${@:4}" ;;
            *) echo "Uso: vhctl worlds {list|create <nombre> [clave=valor ...]|switch <nombre>|delete <nombre> --confirm|modifiers <nombre> [set clave=valor ...]}" >&2; exit 1 ;;
        esac
        ;;
    *)
        cmd_help
        exit 1
        ;;
esac
